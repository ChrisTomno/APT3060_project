<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F7"
    tools:context=".MainActivity">

   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:padding="16dp">

       <com.google.android.material.card.MaterialCardView
           android:id="@+id/cardPersonalDetails"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginBottom="16dp"
           app:cardCornerRadius="12dp"
           app:cardElevation="4dp"
           app:cardBackgroundColor="@android:color/white"
           app:strokeColor="#E0E0E0"
           app:strokeWidth="1dp">

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical"
               android:padding="16dp">

               <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_personal_details"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp"/>

               <com.google.android.material.textfield.TextInputLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:hint="@string/et_full_name"
                   style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                   <com.google.android.material.textfield.TextInputEditText
                       android:id="@+id/etFullName"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:inputType="text"/>

               </com.google.android.material.textfield.TextInputLayout>

               <com.google.android.material.textfield.TextInputLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="8dp"
                   android:hint="@string/et_id_no"
                   style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                   <com.google.android.material.textfield.TextInputEditText
                       android:id="@+id/etIdNo"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:inputType="text"/>

               </com.google.android.material.textfield.TextInputLayout>

               <com.google.android.material.textfield.TextInputLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:hint="@string/et_email"
                   style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                   <com.google.android.material.textfield.TextInputEditText
                       android:id="@+id/etEmail"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:inputType="text"/>

               </com.google.android.material.textfield.TextInputLayout>

           </LinearLayout>
       </com.google.android.material.card.MaterialCardView>

       <com.google.android.material.card.MaterialCardView
           android:id="@+id/cardAcademicDetails"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginBottom="16dp"
           app:cardCornerRadius="12dp"
           android:elevation="4dp"
           app:cardBackgroundColor="@android:color/white"
           app:strokeColor="#E0E0E0E0"
           app:strokeWidth="1dp">

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical"
               android:padding="16dp">

               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/card_academic_details"
                   android:textSize="18sp"
                   android:textStyle="bold"
                   android:textColor="#333333"
                   android:layout_marginBottom="12dp"/>

               <com.google.android.material.textfield.TextInputLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:hint="@string/et_reg_no"
                   style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                   <com.google.android.material.textfield.TextInputEditText
                       android:id="@+id/etRegNo"
                       android:layout_width="wrap_content"
                       android:layout_height="match_parent"
                       android:inputType="text"/>
               </com.google.android.material.textfield.TextInputLayout>

               <com.google.android.material.textfield.TextInputLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="8dp"
                   android:hint="@string/et_course"
                   style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                   <com.google.android.material.textfield.TextInputEditText
                       android:id="@+id/etCourse"
                       android:layout_width="wrap_content"
                       android:layout_height="match_parent"
                       android:inputType="text"/>
               </com.google.android.material.textfield.TextInputLayout>

               <com.google.android.material.textfield.TextInputLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:hint="@string/et_department"
                   style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                   <com.google.android.material.textfield.TextInputEditText
                       android:id="@+id/etDepartment"
                       android:layout_width="wrap_content"
                       android:layout_height="match_parent"
                       android:inputType="text"/>
               </com.google.android.material.textfield.TextInputLayout>

           </LinearLayout>

       </com.google.android.material.card.MaterialCardView>

   </LinearLayout>

</ScrollView>